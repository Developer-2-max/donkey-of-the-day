# Copy to .env on the server:  cp .env.example .env   then edit. docker compose reads it automatically.
# Paste the OAuth client ID from Google Cloud Console to switch on Sign in with Google (leave empty to keep it off).
# Players must sign in (username + password, or Google) before they can create or join a room. Set to 0 to let guests play.
REQUIRE_LOGIN=1
GOOGLE_CLIENT_ID=

# Optional (these are the defaults)
# PUBLIC_ROOMS=1
# IDLE_CLOSE_MIN=30
# ROOM_TTL_HOURS=72
# GAME_TZ_OFFSET_MIN=330
# BANNED_WORDS=
